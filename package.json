{
  "name": "eez-rollup-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:composer": "node tests/composer-discovery.test.mjs",
    "test:visualizer": "node tests/execution-debugger.test.mjs",
    "test:debug": "npm run build && node tests/quote-trace-debugger.cjs && node tests/quote-debug-form.cjs",
    "dev": "vite",
    "build": "node scripts/check-treasury-release.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs src/lib/fees/*.test.mjs tests/falcon/*.test.ts",
    "test:fees": "node --test src/lib/fees/*.test.mjs",
    "test:fees:browser": "node tests/cross-chain-fees.cjs && node tests/cross-chain-call-fees.cjs",
    "test:fees:config": "node tests/fee-config.cjs",
    "test:fees:kurtosis": "node tests/cross-chain-fees-kurtosis.cjs",
    "build:contracts": "forge build --root contracts/legacy && forge build --root contracts",
    "test:contracts": "forge build --root contracts/legacy && forge test --root contracts",
    "test:treasury-signatures": "node --test tests/treasury-signatures.test.mjs",
    "test:treasury:setup": "npm run build:contracts && node tests/integration/treasury-paired-setup.mjs",
    "test:treasury:browser": "npm run build:contracts && node tests/integration/treasury-paired-setup.mjs --browser",
    "test:treasury:integration": "python3 scripts/run-treasury-integration.py",
    "test:treasury:ui": "python3 scripts/run-treasury-integration.py --ui test",
    "dev:treasury": "python3 scripts/run-treasury-integration.py --ui serve",
    "treasury:safe": "python3 scripts/treasury-safe/rehearsal.py",
    "treasury:network": "node scripts/treasury-network.mjs",
    "build:treasury-artifacts": "npm run build:treasury-release",
    "check:treasury-artifacts": "npm run check:treasury-release",
    "treasury:mainnet": "node scripts/treasury-mainnet.mjs",
    "build:treasury-release": "npm run build:contracts && node scripts/build-treasury-release.mjs",
    "check:treasury-release": "node scripts/build-treasury-release.mjs --check && node scripts/check-treasury-release.mjs",
    "treasury:verification": "node --experimental-strip-types scripts/verification/server.mjs http://127.0.0.1:8080 .runtime/treasury-verification/jobs",
    "test:treasury-verification": "node --test tests/treasury-verification.test.mjs",
    "test:treasury-verification:integration": "node tests/integration/treasury-source-verification.mjs",
    "test:falcon:browser": "node tests/falcon-navigation.mjs && node tests/falcon-keystore.mjs && node tests/falcon-wallet.mjs && node tests/falcon-recovery-browser.mjs"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.10",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "1.63.0",
    "typescript": "~5.6.0",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
