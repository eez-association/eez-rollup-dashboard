# Bound public verification requests independently of RPC/transaction traffic.
limit_req_zone $binary_remote_addr zone=treasury_verification:1m rate=2r/s;

server {
    listen ${EEZ_UI_LISTEN};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Use the upstream hostname for TLS virtual hosts.
    proxy_ssl_server_name on;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /config.json {
        add_header Cache-Control "no-store";
        try_files /config.json =404;
    }

    # Direct access uses the build's /dashboard/ asset URLs. The public gateway
    # strips that prefix before forwarding, so both forms reach the same files.
    location = /dashboard { return 308 "/dashboard/"; }
    location ^~ /dashboard/ {
        rewrite ^/dashboard/(.*)$ /$1 last;
    }

    location = /rpc/l1 {
        proxy_pass ${EEZ_UI_L1_RPC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    location = /rpc/l2 {
        proxy_pass ${EEZ_UI_L2_RPC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    location = /composer/l1 {
        proxy_pass ${EEZ_UI_L1_FRONT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    location = /composer/l2 {
        proxy_pass ${EEZ_UI_L2_FRONT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    # Runtime configuration is generated as /config.json. Do not let missing
    # legacy /shared files fall through to the SPA and masquerade as env data.
    location ^~ /shared/ {
        return 404;
    }

    location = /monitor { return 308 "/monitor/"; }
    location = /monitor/ { try_files /index.html =404; }

    location /monitor/api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $monitor_upstream ${EEZ_UI_MONITOR_UPSTREAM};
        rewrite ^/monitor/(.*)$ /$1 break;
        proxy_pass http://$monitor_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /trace/api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $trace_upstream ${EEZ_UI_TRACE_UPSTREAM};
        rewrite ^/trace/(.*)$ /$1 break;
        proxy_pass http://$trace_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_buffering off;
        proxy_read_timeout 15s;
        client_max_body_size 2k;
    }

    # This worker shares the UI's network namespace. It publishes only retained
    # source bundles; requests cannot choose an RPC URL or compiler input.
    location /treasury-verification/ {
        limit_req zone=treasury_verification burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 2k;
        proxy_pass http://127.0.0.1:18081/;
        proxy_http_version 1.1;
    }

    location /cowdemo/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $cow_upstream ${EEZ_UI_COW_UPSTREAM};
        rewrite ^/cowdemo/(.*)$ /$1 break;
        proxy_pass $cow_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
