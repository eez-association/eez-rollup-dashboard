COW_NETWORK=mainnet
# Profile defaults are in config/networks/<name>.json. All fields can be
# overridden here. Paths are relative to demos/cow-light, not your shell cwd.
# Runtime files default to runtime/<name>/; do not share queues across networks.
# COWSWAP_ARTIFACTS=/path/to/cowswap/artifacts
# GPV2_ARTIFACT defaults to COWSWAP_ARTIFACTS/GPv2Settlement.json.
# Set only in a protected environment, never in git:
# SOLVER_KEY_FILE=/run/secrets/eez-cow-solver
# Browser-reachable endpoints when internal RPCs use localhost/container names.
COW_PUBLIC_L1_RPC=
COW_PUBLIC_L2_FRONT=
COW_FAUCET_L1=
