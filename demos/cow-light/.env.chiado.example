COW_NETWORK=chiado
# Set COW_ENV_FILE=/absolute/path/to/dashboard/.env to read public settings,
# or export the dashboard environment first to reuse EEZ_UI_L1_RPC_UPSTREAM,
# EEZ_UI_L2_RPC_UPSTREAM, EEZ_UI_L2_FRONT_UPSTREAM and explorer URLs.
# Bridges, manager and rollup reuse EEZ_L1_BRIDGE_SENDER,
# EEZ_L2_BRIDGE_RECEIVER, EEZL2_ADDRESS and EEZ_ROLLUP_ID.
# Non-empty values below override those shared settings. Endpoints must be
# reachable from the demo process (Docker hostnames may not work on the host).
# L2 chain ID is discovered from L2_RPC; optionally pin L2_CHAIN_ID explicitly.
# Fill infrastructure addresses from that deployment. No mainnet fallback is used.
# No rollup ID default: supply EEZ_ROLLUP_ID in the shared .env or L2_ROLLUP_ID.
# Old deployment snapshots must not be reused after a reset, even if chain ID is unchanged.
# Signing keys must still be supplied separately through the protected process environment.
L1_RPC=
L2_RPC=
L2_FRONT=
L2_EXPLORER=
EEZ_MANAGER_L2=
BRIDGE_L1=
BRIDGE_L2=
L2_ROLLUP_ID=
# Optional explicit genesis pin, checked against the L2 RPC:
L2_GENESIS_HASH=
# WETH_L1 is a test ERC20 used by your funded V2 pool, not native xDAI.
# WETH_L2 is its canonical bridged wrapper on EEZ-X.
WETH_L1=
WETH_L2=
DETERMINISTIC_FACTORY_L1=
# Maximum total fee per cross-chain deployment / solver transaction (wei).
COW_DEPLOY_MAX_FEE_WEI=5000000000000000
COW_SOLVER_MAX_FEE_WEI=5000000000000000
# SETTLEMENT_L2 is read from runtime/chiado/cow-deployment.json after deployment.
# Supply creation-code trace information before quoting undeployed wrappers:
# WRAPPER_REFERENCE_TX=0x...
# WRAPPER_PREFIX_LEN=...
# COWSWAP_ARTIFACTS=/path/to/cowswap/artifacts
# SOLVER_KEY_FILE=/run/secrets/eez-cow-solver-chiado
